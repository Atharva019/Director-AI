# ===========================================
# Director AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://director:director_secret@localhost:5432/director_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Groq (primary AI provider — fast inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_DEFAULT_MODEL=qwen/qwen3.6-27b

# --- Gemini (fallback AI provider — generous free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# --- Firebase ---
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=../private/director-ai-55e1e-firebase-adminsdk-fbsvc-22528e30e4.json

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
