# ===========================================
# Director AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://director:director_secret@localhost:5432/director_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- NVIDIA NIM (primary AI provider — OpenAI-compatible vision API) ---
# Get a key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Legacy names still supported:
# GROQ_API_KEY=your_nvidia_api_key_here
# GROQ_DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Gemini (optional fallback — disabled by default while testing NIM) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# --- Firebase ---
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=../private/director-ai-55e1e-firebase-adminsdk-fbsvc-22528e30e4.json

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
