# ===========================================
# Director AI — Environment Variables
# ===========================================
# Copy this file to .env and fill in values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://director:director_secret@localhost:5432/director_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b

# --- Firebase ---
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=../private/director-ai-55e1e-firebase-adminsdk-fbsvc-22528e30e4.json

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
