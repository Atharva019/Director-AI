# Director AI — backend environment.
# Copy to .env and fill in. NEVER commit the filled-in file.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development           # "production" enables strict CORS + Firebase fail-fast
APP_DEBUG=false               # must stay false in production

# ── Database ──────────────────────────────────────────────────────────────────
# Neon: copy the pooled connection string and swap the driver to +asyncpg.
DATABASE_URL=postgresql+asyncpg://director:director_secret@localhost:5432/director_ai

# ── AI providers (NVIDIA NIM primary, Gemini fallback) ────────────────────────
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Production: paste the whole service-account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local only: path to the service-account file (gitignored).
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Cloudflare R2 (image storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=           # e.g. https://pub-xxxxxxxx.r2.dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. In production set this to your exact Vercel domain.
CORS_ORIGINS=http://localhost:3000

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
