# Director AI — backend environment.
# Copy to .env and fill in. NEVER commit the filled-in file.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development           # "production" enables strict CORS + Firebase fail-fast
APP_DEBUG=false               # must stay false in production

# ── Database ──────────────────────────────────────────────────────────────────
# Neon/Supabase/Heroku: paste the connection string verbatim — the app
# normalises the driver scheme and query params for both asyncpg and psycopg2.
DATABASE_URL=postgresql+asyncpg://director:director_secret@localhost:5432/director_ai

# ── AI providers (NVIDIA NIM primary, Gemini fallback) ────────────────────────
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Production: paste the whole service-account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local only: path to the service-account file (gitignored).
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Object storage (any S3-compatible provider) ───────────────────────────────
# Cloudflare R2:      https://<account_id>.r2.cloudflarestorage.com   region=auto
# Supabase Storage:   https://<project>.supabase.co/storage/v1/s3     region=<proj region>
# Backblaze B2:       https://s3.<region>.backblazeb2.com             region=<region>
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=           # public read base, e.g. https://pub-xxxxxxxx.r2.dev
S3_REGION=auto

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. In production set this to your exact Vercel domain.
CORS_ORIGINS=http://localhost:3000

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
