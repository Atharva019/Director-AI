# Director AI — frontend environment.
# Copy to .env.local and fill in. NEVER commit the filled-in file.
#
# NEXT_PUBLIC_* values are compiled into the client bundle and are therefore
# PUBLIC. The Firebase web config below is designed to be public — access is
# controlled by Firebase Auth rules, not by hiding these keys. Never put a
# server-side secret behind a NEXT_PUBLIC_ prefix.

# ── Firebase web app ──────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── API ───────────────────────────────────────────────────────────────────────
# The deployed backend origin (Render URL in production).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-side rewrite target — usually the same value as NEXT_PUBLIC_API_URL.
API_PROXY_ORIGIN=http://127.0.0.1:8000

# ── Images ────────────────────────────────────────────────────────────────────
# Public hostname of the R2 bucket, so next/image will load analysis images.
# e.g. pub-xxxxxxxx.r2.dev  (hostname only — no scheme, no trailing slash)
NEXT_PUBLIC_R2_HOSTNAME=
